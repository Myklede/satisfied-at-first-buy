{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ChartValue": {
      "additionalProperties": false,
      "description": "A chart cell in the chart's own unit, exactly as printed (checked against the page).",
      "properties": {
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 300,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "min": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 300,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 300,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "raw": {
          "default": "",
          "maxLength": 120,
          "title": "Raw",
          "type": "string"
        }
      },
      "title": "ChartValue",
      "type": "object"
    },
    "ExtractedSize": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,23}$",
          "title": "Name",
          "type": "string"
        },
        "measurements": {
          "additionalProperties": {
            "$ref": "#/$defs/ChartValue"
          },
          "propertyNames": {
            "enum": [
              "chest",
              "waist",
              "hip",
              "hem",
              "shoulder",
              "sleeve",
              "sleeve_cb",
              "length",
              "bicep"
            ]
          },
          "title": "Measurements",
          "type": "object"
        }
      },
      "required": [
        "name",
        "measurements"
      ],
      "title": "ExtractedSize",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "reviewed",
            "rules",
            "llm"
          ],
          "title": "Source",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "extracted_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Extracted By",
          "type": "string"
        },
        "reviewed": {
          "default": false,
          "title": "Reviewed",
          "type": "boolean"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}",
          "title": "Date",
          "type": "string"
        },
        "source_page": {
          "anyOf": [
            {
              "pattern": "^[^/\\\\:*?\\\"<>|]{1,200}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page"
        }
      },
      "required": [
        "source",
        "extracted_by",
        "date"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "File format of data/amazon-pages/reviewed/<ASIN>.json (schema: fit-agent-extraction).",
  "properties": {
    "asin": {
      "pattern": "^[A-Z0-9]{10}$",
      "title": "Asin",
      "type": "string"
    },
    "title": {
      "default": "",
      "maxLength": 400,
      "title": "Title",
      "type": "string"
    },
    "brand": {
      "default": "",
      "maxLength": 200,
      "title": "Brand",
      "type": "string"
    },
    "category": {
      "enum": [
        "jacket",
        "coat",
        "hoodie",
        "sweatshirt",
        "t-shirt",
        "shirt",
        "polo",
        "sweater",
        "top"
      ],
      "title": "Category",
      "type": "string"
    },
    "chart_type": {
      "enum": [
        "garment",
        "body"
      ],
      "title": "Chart Type",
      "type": "string"
    },
    "unit": {
      "enum": [
        "cm",
        "in"
      ],
      "title": "Unit",
      "type": "string"
    },
    "flat_fields": {
      "default": [],
      "items": {
        "enum": [
          "chest",
          "waist",
          "hip",
          "hem",
          "shoulder",
          "sleeve",
          "sleeve_cb",
          "length",
          "bicep"
        ],
        "type": "string"
      },
      "title": "Flat Fields",
      "type": "array"
    },
    "fit_intent": {
      "default": "regular",
      "enum": [
        "slim",
        "regular",
        "loose",
        "oversized"
      ],
      "title": "Fit Intent",
      "type": "string"
    },
    "construction": {
      "default": "set_in",
      "enum": [
        "set_in",
        "drop_shoulder",
        "raglan"
      ],
      "title": "Construction",
      "type": "string"
    },
    "fabric": {
      "default": "",
      "maxLength": 1000,
      "title": "Fabric",
      "type": "string"
    },
    "sizes": {
      "items": {
        "$ref": "#/$defs/ExtractedSize"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Sizes",
      "type": "array"
    },
    "headers": {
      "additionalProperties": {
        "maxLength": 120,
        "type": "string"
      },
      "default": {},
      "propertyNames": {
        "enum": [
          "chest",
          "waist",
          "hip",
          "hem",
          "shoulder",
          "sleeve",
          "sleeve_cb",
          "length",
          "bicep"
        ]
      },
      "title": "Headers",
      "type": "object"
    },
    "evidence": {
      "default": [],
      "items": {
        "maxLength": 300,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Evidence",
      "type": "array"
    },
    "assumptions": {
      "default": [],
      "items": {
        "maxLength": 300,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Assumptions",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "asin",
    "category",
    "chart_type",
    "unit",
    "sizes",
    "provenance"
  ],
  "title": "ReviewedExtraction",
  "type": "object"
}
