# Names only. The service will resolve the model cache inside the repository.
ANNY_CACHE_DIR=
# Decart Lucy V-TON trial page only (apps/web/decart.html + scripts/decart-token-server.mjs).
# Free credits only (docs/USER-RULES.md 2026-11-15). Never commit the real key.
DECART_API_KEY=
# Hard daily cap on streamed seconds across all trial sessions (default 900 = $18 at list price).
DECART_MAX_TOTAL_S=900

# Hard all-time dollar cap across all Decart sessions on this machine (max 30, the user rule).
DECART_MAX_USD=30
